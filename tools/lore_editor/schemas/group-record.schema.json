{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AphelionDevelopment/aphelion-content-tools/schema/group-record.json",
  "title": "Aphelion lore group",
  "type": "object",
  "required": ["id", "label", "color", "keywords", "type_path_prefixes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "label": {"type": "string", "minLength": 1},
    "color": {"type": "string", "minLength": 1},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "type_path_prefixes": {"type": "array", "items": {"type": "string", "pattern": "^/"}}
  },
  "additionalProperties": false
}
